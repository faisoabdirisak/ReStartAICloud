{
  "name": "@restart-ai/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
   "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src --ext .ts",
    "db:push": "prisma db push --schema=../prisma/schema.prisma",
    "db:generate": "prisma generate --schema=../prisma/schema.prisma",
    "db:seed": "tsx --env-file=.env ../prisma/seed.ts",
    "db:studio": "dotenv -e .env -- prisma studio --schema=../../prisma/schema.prisma"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "@prisma/client": "^5.19.1",
    "@restart-ai/shared": "*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.5",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "prisma": "^5.19.1",
    "tsx": "^4.19.1",
    "typescript": "^5.5.3",
    "vitest": "^2.0.5"
  }
}
