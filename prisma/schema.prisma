// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Session {
  id            String        @id @default(cuid())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  opportunities Opportunity[]
}

model Opportunity {
  id               String      @id @default(cuid())
  sessionId        String
  session          Session     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  title            String
  category         String      // 'career-pivot' | 'upskilling' | 'micro-business'
  summary          String
  reasoning        String
  /// Computed server-side in TypeScript — never from AI output
  feasibilityScore Int
  rank             Int
  planItems        PlanItem[]
}

model PlanItem {
  id             String      @id @default(cuid())
  opportunityId  String
  opportunity    Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  day            Int
  week           Int
  title          String
  description    String?
  resourceUrl    String?
  progressEntry  ProgressEntry?
}

model ProgressEntry {
  id          String   @id @default(cuid())
  planItemId  String   @unique
  planItem    PlanItem @relation(fields: [planItemId], references: [id], onDelete: Cascade)
  isCompleted Boolean  @default(false)
  completedAt DateTime?
  updatedAt   DateTime @updatedAt
}
